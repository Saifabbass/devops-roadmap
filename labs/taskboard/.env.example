# Documentation only. tools/init_lab.py generates unpredictable local values in .env.
# Do not copy this file over an existing .env. Do not commit .env.
TASKBOARD_STAGE=07
# POSTGRES_PASSWORD is the password for the disposable development database.
# TEST_DB_PASSWORD belongs only to the separate disposable test database.
# LAB_ALICE_TOKEN and LAB_BOB_TOKEN are separate opaque local teaching tokens.
# TASKBOARD_IMAGE may select a previously built registry/repository@sha256:digest.
